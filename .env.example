# Copy to .env.local for local runs; set the same keys in Vercel → Project → Settings → Environment Variables.

# Live address, no trailing slash. Default: https://www.investingplots.com
NEXT_PUBLIC_SITE_URL=

# Lead copy goes here as JSON, from the server. Use the Apps Script web app URL from tools/daily-report.gs
# (enquiries land in the "Leads" tab of your Google Sheet), or Zapier / Make / a CRM. Strongly recommended.
LEAD_WEBHOOK=

# Daily email report: the same Apps Script web app URL. Visits and WhatsApp / call taps go to the "Visits" tab.
NEXT_PUBLIC_STATS_WEBHOOK=

# Google
NEXT_PUBLIC_GA_ID=
# Google Ads lead conversion "send to", e.g. AW-123456789/AbCdEfGhIj (form sent — primary conversion)
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO=
# Optional second Google Ads conversion for WhatsApp / call taps, e.g. AW-123456789/XyZ123 (set as secondary)
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_SEND_TO=
# Google Tag Manager container for investingplots.com, e.g. GTM-XXXXXXX. Blank = off.
# If GA4 or the Ads conversion is also set up inside GTM, leave the matching key above blank or it counts twice.
NEXT_PUBLIC_GTM_ID=
# Search Console → HTML tag: paste the content value (or the whole tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Microsoft Clarity project ID (clarity.microsoft.com → Settings → Overview). Session recordings and heatmaps.
NEXT_PUBLIC_CLARITY_ID=

# Meta (Instagram + Facebook)
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → Settings → Conversions API → Generate access token (server only, keep secret)
META_CAPI_TOKEN=
# Business settings → Brand safety → Domains → meta tag content value
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
