# Copy to .env.local for local runs; set the same keys in Vercel → Project → Settings → Environment Variables.

# Live address, no trailing slash. Default: https://www.investingplots.com
NEXT_PUBLIC_SITE_URL=

# Lead copy goes here as JSON (Google Apps Script web app, Zapier, Make, CRM). Strongly recommended.
LEAD_WEBHOOK=

# Google
NEXT_PUBLIC_GA_ID=
# Google Ads conversion "send to", e.g. AW-123456789/AbCdEfGhIj (Search + YouTube campaigns)
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO=
# Search Console → HTML tag: paste the content value (or the whole tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Meta (Instagram + Facebook)
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → Settings → Conversions API → Generate access token (server only, keep secret)
META_CAPI_TOKEN=
# Business settings → Brand safety → Domains → meta tag content value
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
